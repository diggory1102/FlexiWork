{
  "expo": {
    "name": "FlexiWork",
    "slug": "flexiwork",
    "scheme": "flexiwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.flexiwork.mobile",
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "vn.flexiwork.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F1E9D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "FlexiWork cần quyền camera để chụp ảnh selfie chấm công và ảnh minh chứng công việc.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FlexiWork cần truy cập thư viện ảnh để bạn chọn ảnh đại diện.",
          "cameraPermission": "FlexiWork cần quyền camera để chụp ảnh selfie chấm công và ảnh minh chứng công việc.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FlexiWork cần vị trí GPS và thông tin Wi-Fi để xác minh bạn đang ở chi nhánh khi chấm công."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F8F4EA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d0f64e4b-5880-4678-9879-ed059c8e7d00"
      }
    },
    "owner": "diggory1102"
  }
}
