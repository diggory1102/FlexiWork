# Copy thành .env.local và chỉnh theo môi trường.
# Điện thoại thật: "localhost" là chính điện thoại — dùng IP LAN của máy chạy backend (VD: 192.168.1.10)
#   và chạy backend với: dotnet run --launch-profile http --urls http://0.0.0.0:5010
# Android Emulator: dùng 10.0.2.2 thay cho localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5010/api
EXPO_PUBLIC_HUB_BASE_URL=http://192.168.1.10:5010/hubs
